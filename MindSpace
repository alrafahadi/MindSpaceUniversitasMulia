.x{color:var(--red);cursor:pointer;background:none;border:0;font-weight:700}
@media (max-width:560px){.logo{font-size:1.1rem}.hero{padding:40px 0 48px}.chat{height:330px}}
nav a.on{background:#fff;color:var(--red)}.pg{min-height:55vh}section.pg{background:var(--bg)}.ed{outline:2px dashed var(--red);outline-offset:3px;min-height:1em}#ebar{position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:40;display:none;gap:8px}#ebar .btn{margin:0;background:var(--red);color:#fff;box-shadow:0 3px 12px #0005}#ebar .btn.w{background:#fff;color:var(--red);border:2px solid var(--red)}</style>
