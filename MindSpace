:root[data-theme="dark"]{--bg:#1c0b0e;--bg2:#250f13;--tx:#fbeff0;--mut:#d9b3b8;--line:#4a2128;--card:#2b1217;--soft:#3a171d;color-scheme:dark}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.65 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
