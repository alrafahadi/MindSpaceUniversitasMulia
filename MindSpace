.breath{width:150px;height:150px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;margin:14px auto;font-weight:700;text-align:center;transition:transform 4s ease-in-out}
.wall{display:grid;gap:10px;margin-top:14px}
